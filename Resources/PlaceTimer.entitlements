<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    App Store icin sandbox zorunlu. Yerel derlemeler de ayni entitlement'larla
    imzalaniyor: sandbox altinda kirilan bir sey varsa magazaya yollamadan
    once, gelistirme sirasinda gorunsun.

    Sandbox'ta veri klasoru konteynerin icine tasinir:
    ~/Library/Containers/com.ardaipek.placetimer/Data/Library/Application Support/PlaceTimer
    Eski konumdaki veri tasinmiyor; uygulama sifirdan baslar.
  -->
  <key>com.apple.security.app-sandbox</key>
  <true/>

  <!--
    Iki is birden: CoreLocation ve CoreWLAN. macOS 14'ten beri Wi-Fi ag adi
    yalnizca konum izniyle okunabiliyor, dolayisiyla bu uygulamanin cekirdek
    islevi bu entitlement'a bagli.
  -->
  <key>com.apple.security.personal-information.location</key>
  <true/>

  <!--
    MKLocalSearch icin. Taninmayan bir aga baglanildiginda yakindaki mekan
    isimlerini onermek uzere Apple Haritalar'a istek gidiyor; sandbox'ta bu
    entitlement olmadan istek sessizce basarisiz olur ve oneri listesi hep bos
    gelir. Baska hicbir ag erisimi yok.
  -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
